<%- include('../partials/header') %>

<main class="movie-library-page">

    <!-- Page heading -->
    <section class="library-heading">
        <div class="container">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center gap-3">

                <div>
                    <h1>My Movie Library</h1>

                    <p>
                        Explore and manage your
                        personal movie collection.
                    </p>
                </div>

                <a href="/movies/new"
                   class="btn btn-movie-primary">
                    + Add New Movie
                </a>

            </div>
        </div>
    </section>

    <!-- Movie collection -->
    <section class="library-section">
        <div class="container">

            <% if (movies.length === 0) { %>

                <!-- Empty library message -->
                <div class="empty-library text-center">

                    <div class="empty-icon">🎞️</div>

                    <h2>Your Movie Library Is Empty</h2>

                    <p>
                        You haven't added any movies yet.
                        Start building your personal
                        collection today!
                    </p>

                    <a href="/movies/new"
                       class="btn btn-movie-primary">
                        Add Your First Movie
                    </a>

                </div>

            <% } else { %>

                <div class="row g-4">

                    <% movies.forEach(movie => { %>

                        <div class="col-lg-4 col-md-6">

                            <div class="card movie-card h-100">

                                <div class="card-body">

                                    <div class="movie-card-icon">
                                        🎬
                                    </div>

                                    <h3 class="card-title">
                                        <%= movie.title %>
                                    </h3>

                                    <div class="movie-meta">

                                        <span class="badge bg-primary">
                                            <%= movie.genre %>
                                        </span>

                                        <span class="badge bg-secondary">
                                            <%= movie.releaseYear %>
                                        </span>

                                    </div>

                                    <p class="movie-detail">
                                        <strong>Director:</strong>
                                        <%= movie.director || 'Not specified' %>
                                    </p>

                                    <p class="movie-detail">
                                        <strong>Status:</strong>
                                        <%= movie.watchStatus %>
                                    </p>

                                    <p class="movie-detail">
                                        <strong>Rating:</strong>

                                        <% if (movie.rating != null) { %>
                                            ⭐ <%= movie.rating %>/10
                                        <% } else { %>
                                            Not rated
                                        <% } %>
                                    </p>

                                    <% if (movie.description) { %>

                                        <p class="movie-description">
                                            <%= movie.description %>
                                        </p>

                                    <% } %>

                                    <div class="movie-actions mt-4">
                                        
                                        <a
                                            href="/movies/<%= movie._id %>/edit"
                                            class="btn btn-movie-primary">
                                        
                                            Edit Movie
                                            
                                        </a>

                                        <form
                                            action="/movies/<%= movie.id %>delete"
                                            method="POST"
                                            class="delete-movie-form"
                                            onsubmit="return confirm('Are you sure you want to delete this movie? This action cannot be undone.');">
                                        
                                            <button
                                                type="submit"
                                                class="btn btn-danger">
                                                Delete Movie
                                            </button>
                                            
                                        </form>

                                        
                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } %>

        </div>
    </section>

</main>

<%- include('../partials/footer') %>